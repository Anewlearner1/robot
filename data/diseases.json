            "重點按壓足弓至腳跟區域"
          ],
          "cautions": ["每次不超過 10 分鐘，避免凍傷", "力道輕柔，以舒適為主"],
          "sets": "2 組",
          "reps": "每組 5 分鐘",
          "equipment": "冰凍寶特瓶"
        }
      ],
      "recovery": [
        {
          "id": "plantar-calf-stretch",
          "name": "小腿伸展",
          "gif": "/gifs/plantar-calf-stretch.gif",
          "steps": [
            "面對牆壁站立，雙手扶牆",
            "患腿向後退一大步，腳跟踩實地面",
            "身體前傾，感到小腿後側拉伸，維持 30 秒"
          ],
          "cautions": ["腳跟全程不離地", "不要彎曲後腳膝蓋"],
          "sets": "3 組",
          "reps": "每組 3 次",
          "equipment": "牆壁"
        }
      ],
      "strengthening": [
        {
          "id": "plantar-towel-scrunch",
          "name": "毛巾抓握運動",
          "gif": "/gifs/plantar-towel-scrunch.gif",
          "steps": [
            "坐於椅上，地面放一條小毛巾",
            "用腳趾抓住毛巾往腳心堆疊",
            "重複展開再抓握"
          ],
          "cautions": ["若有足部痙攣立即停止", "赤腳進行效果最佳"],
          "sets": "3 組",
          "reps": "每組 10 次",
          "equipment": "毛巾"
        }
      ]
    }
  },
  {
    "id": "rotator-cuff",
