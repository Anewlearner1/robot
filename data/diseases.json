          "steps": [
            "雙手握彈力帶，手臂向前平伸",
            "將彈力帶水平向外拉開至胸口寬度",
            "緩慢回到起始位置"
          ],
          "cautions": ["保持肩胛骨下沉，不聳肩", "阻力選擇以能控制動作為準"],
