[
  {
    "id": "lower-back-pain",
    "name": "下背痛",
    "aliases": ["腰痛", "腰酸", "下腰痛"],
    "description": "下背部疼痛，常見於久坐族群，通常由肌肉緊繃或椎間盤問題引起",
    "phases": {
      "acute": [
        {
          "id": "knee-to-chest",
          "name": "抱膝運動",
          "gif": "/gifs/knee-to-chest.gif",
          "steps": [
            "平躺於床上或瑜珈墊，雙腿伸直",
            "緩慢將一側膝蓋抱向胸前，維持 10–15 秒",
            "放鬆還原，換另一側重複"
          ],
          "cautions": [
            "若疼痛加劇，立即停止",
            "急性疼痛期避免過度施力"
          ],
          "sets": "3 組",
          "reps": "每組 10 次",
          "equipment": "徒手"
        },
        {
          "id": "cat-cow",
          "name": "貓牛式伸展",
          "gif": "/gifs/cat-cow.gif",
          "steps": [
            "四足跪地，雙手在肩膀正下方，膝蓋在臀部正下方",
            "吸氣時背部下沉、頭部抬起（牛式）",
            "吐氣時拱背、低頭（貓式）",
            "緩慢交替進行"
          ],
          "cautions": [
            "動作宜緩，避免過度伸展",
            "頸部不要強行後仰"
          ],
          "sets": "3 組",
          "reps": "每組 10 次",
          "equipment": "徒手"
        }
      ],
      "recovery": [
        {
          "id": "bird-dog",
          "name": "鳥狗式",
          "gif": "/gifs/bird-dog.gif",
          "steps": [
            "四足跪地，保持脊椎中立",
            "同時伸展右手與左腳，維持 3–5 秒",
            "回到起始姿勢，換左手右腳",
            "交替進行"
          ],
          "cautions": [
            "保持骨盆水平，避免歪斜",
            "核心持續收縮"
          ],
          "sets": "3 組",
          "reps": "每側 10 次",
          "equipment": "徒手"
        }
      ],
      "strengthening": [
        {
          "id": "dead-bug",
          "name": "死蟲式",
          "gif": "/gifs/dead-bug.gif",
          "steps": [
            "平躺，雙臂垂直舉起，雙腳抬起膝蓋彎曲 90 度",
            "吸氣，右手往頭頂方向延伸，同時左腳往地面延伸",
            "吐氣回到起始位置，換另一側"
          ],
          "cautions": [
            "腰背始終貼地",
            "動作過程中保持正常呼吸"
          ],
          "sets": "3 組",
          "reps": "每側 8 次",
          "equipment": "徒手"
        }
      ]
    }
  }
]
